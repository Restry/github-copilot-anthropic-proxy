# ─── 本地运行：以下全部不需要 ─────────────────────────────────────
# 直接 `node server.mjs` 即可，loopback 自动免登进 dashboard。

# ─── 服务器部署：必填 ─────────────────────────────────────────────
# 通过反向代理（Caddy / nginx）对外暴露时，关闭 loopback 免登，
# 否则任何能 curl 到 127.0.0.1 的进程都能拿到 admin 权限。
# DISABLE_LOCALHOST_BYPASS=1

# 反向代理在前面时打开，让日志记录真实客户端 IP（X-Forwarded-For）。
# TRUST_PROXY=1

# 监听端口（默认 4819）
# PORT=4819

# ─── 可选：微信扫码登录 ──────────────────────────────────────────
# 配置后 dashboard 默认走微信登录；未配置则 fallback 到 API key 登录。
# WX_GATEWAY_BASE=https://wx.example.com
# WX_GATEWAY_APP_NAME=copilot-proxy
# WX_GATEWAY_SECRET=...

# ─── 可选：CORS 允许的来源 ───────────────────────────────────────
# CORS_ORIGINS=https://your-frontend.example.com

# ─── 可选：直接注入 GitHub token（替代 device flow）──────────────
# COPILOT_GITHUB_TOKEN=gho_...
